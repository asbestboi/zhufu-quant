[Unit]
Description=qr live run -- plan/approve-gate/resolve this strategy's paper-trading decision
# Runs after the morning data refresh, if qr-ingest.timer is also installed.
After=qr-ingest.service

[Service]
Type=oneshot
# This must be the project whose venv has the strategy's own `qr` plugin installed and
# registered -- for a private strategy (e.g. zhufu-research's `zr`), that is the private
# repo itself, not zhufu-quant: `uv run qr` only sees strategies registered in the venv
# it actually runs in (see the README's "qr.strategies entry point" note).
WorkingDirectory=/path/to/the/project/whose/venv/has/this/strategy/registered
# A plain `uv` (no path) can fail silently here: systemd --user's own PATH is not your
# shell's, and the standalone installer's default (~/.local/bin) is usually not on it
# -- check with `systemctl --user show-environment | grep PATH` and use `which uv`'s
# output below if it's missing.
ExecStart=/path/to/uv run qr live run /path/to/live.yaml --catch-up
