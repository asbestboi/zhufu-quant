# Copy to .env and fill in. Nothing here is needed for the default Yahoo source.
# The qr CLI reads .env from the folder it is run in; real environment variables win.

# Where the DuckDB file and raw Parquet snapshots live (default: ./data)
# QR_DATA_DIR=

# Universe config file (default: ./config/universe.yaml)
# QR_CONFIG=

# Free token from https://www.tiingo.com/account/api/token, used by `qr crosscheck`
# TIINGO_API_KEY=

# Placeholders for future paid providers / brokers
# POLYGON_API_KEY=
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# IBKR_ACCOUNT_ID=
